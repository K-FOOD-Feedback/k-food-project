# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)

# Mixpanel (담당 송희) — 개발 중엔 테스트용 프로젝트 토큰
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Supabase (K-food 프로젝트) — 지금은 의견 저장에만 씀 (src/app/admin/feedback/db.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 의견 관리 /admin/feedback — 서버 전용 (값은 지현·송희에게 받기)
# FEEDBACK_DB_SECRET: DB에서 의견을 읽을 때 쓰는 긴 비밀값
FEEDBACK_DB_SECRET=

# 어드민 비밀번호 (숫자 4자리, 서버 전용) — /admin/login 에서 입력. 값은 지현·송희에게 받기
# 쿠키 서명에 FEEDBACK_DB_SECRET 도 같이 씀 (둘 중 하나라도 없으면 아무도 못 들어감)
ADMIN_PASSWORD=

# 외국인 의견 자동 번역 (DeepL API Free, 서버 전용) — 값은 지현·송희에게 받기
DEEPL_API_KEY=

# 개발용 화면 잠금 (src/proxy.ts) — Vercel에선 Preview 환경에만 넣기. 내 컴퓨터에선 비워 두면 잠금 없음
SITE_PASSWORD=
